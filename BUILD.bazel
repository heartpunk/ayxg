load("@ayxg_pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "ayxg",
    srcs = glob(["python/ayxg/*.py"], exclude = ["python/ayxg/z3.py"]),
    data = ["python/ayxg/py.typed"],
    imports = ["python"],
)

filegroup(
    name = "lean_sources",
    srcs = glob(["Ayxg/**/*.lean"]) + ["Ayxg.lean", "lakefile.lean", "lean-toolchain"],
)

py_library(
    name = "z3",
    srcs = ["python/ayxg/z3.py"],
    imports = ["python"],
    deps = [":ayxg", requirement("z3-solver")],
)

py_test(
    name = "z3_test",
    srcs = ["tests/unit/test_z3.py"],
    deps = [":z3"],
)
